<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>X402.AspNetCore</RootNamespace>
    <AssemblyName>X402.AspNetCore</AssemblyName>

    <!-- NuGet package metadata -->
    <PackageId>X402.AspNetCore</PackageId>
    <Version>0.1.0</Version>
    <Authors>Paywall</Authors>
    <Description>Thin x402 payment-gate middleware for ASP.NET Core. Implements the frozen X402v1 wire contract; relays to the platform's signed challenge/verify and fails closed.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/podariu2004/paywall/tree/main/sdks/aspnetcore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/podariu2004/paywall</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The test project lives under tests/ with its own .csproj; keep it out
       of this package's default compile/content globs. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
