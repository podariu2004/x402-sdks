{
  "name": "x402/laravel",
  "description": "x402 payment gate middleware for Laravel apps — pay-per-request for AI agents.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "illuminate/http": "^10.0",
    "illuminate/support": "^10.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": { "X402\\Laravel\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "X402\\Laravel\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["X402\\Laravel\\X402ServiceProvider"]
    }
  },
  "config": { "sort-packages": true },
  "minimum-stability": "stable"
}
